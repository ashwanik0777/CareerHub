# Dependencies
node_modules/
.pnpm-store/

# Environment files — never commit real credentials (see .env.example)
.env
.env.*
!.env.example

# Next.js / build output
.next/
dist/
out/
.turbo/

# Prisma generated client
packages/db/node_modules/.prisma/

# Large model artifacts (training archive stays out of git; the runtime
# ONNX model in packages/ai-model/model/ is intentionally tracked)
apps/careerhub_production_model/

# OS / editor noise
.DS_Store
*.log
.vscode/
.idea/

# TypeScript incremental build info
*.tsbuildinfo

# Extension sources are bundled by Vite; never commit tsc output next to them
apps/extension/src/**/*.js
apps/extension/src/**/*.js.map
apps/extension/src/**/*.d.ts
apps/extension/src/**/*.d.ts.map
