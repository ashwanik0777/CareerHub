# Copy to .env (repo root) — pnpm/Next.js load it for apps/web, apps/admin and packages/db.
# Never commit the real .env.

# PostgreSQL connection string (docker-compose default shown; use your Neon/RDS URL in prod)
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/platform_db?schema=public"

# Used by docker-compose for the Postgres container
POSTGRES_PASSWORD="change-me"

# HS256 signing key for session JWTs. MUST be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

NODE_ENV="development"

# Optional: absolute path to the ONNX model directory (defaults to packages/ai-model/model/...)
# AI_MODEL_DIR=
